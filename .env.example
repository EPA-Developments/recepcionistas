# =========================================================================
# Segunda Opinión Médica Recepción — variables de entorno (ejemplo)
# Copiar a `.env` y completar. NUNCA commitear el .env real.
#
# Este .env lo leen SOLO los scripts locales (seed, deploy de bots, datos demo,
# diagnósticos). Los bots NO leen este archivo: sus credenciales (Twilio,
# MercadoPago, etc.) son Project Secrets de Medplum — ver el final del archivo.
# =========================================================================

# --- Medplum (servidor y proyecto de Segunda Opinión Médica) ---
MEDPLUM_BASE_URL=https://api.medplum.com.ar/
# Credenciales de una ClientApplication del proyecto SOM (client credentials),
# admin del proyecto para poder crear bots. Se generan en Medplum; nunca en el repo.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Proyecto SOM. Seed, deploy y diagnósticos abortan si las credenciales son de
# otro proyecto (dejarlo vacío desactiva ese chequeo).
MEDPLUM_PROJECT_ID=7ce5e559-f315-4538-abf2-61fa4922f996

# --- Tipo de cambio por defecto (ARS/USD). Configurable por el admin. ---
# Valor de referencia del brief. Se almacena además como recurso FHIR (ver seed).
SOM_TC_DEFAULT=1450

# --- Email transaccional: AWS SES ---
# El email se envía con medplum.sendEmail(), que usa el proveedor configurado en
# el servidor Medplum (AWS SES, región sa-east-1). El remitente REAL es el
# `supportEmail` del server Medplum (hola@medplum.com.ar), que debe ser una
# identidad SES verificada. No hacen falta credenciales de SES en el código.
# SES_FROM_EMAIL es opcional y SOLO lo usa `npm run email:test` para probar un
# remitente explícito; los bots NO lo setean (dejan que el server elija).
SES_FROM_EMAIL=hola@medplum.com.ar

# =========================================================================
# Project Secrets de Medplum (Project → Secrets del proyecto SOM)
# Se cargan en Medplum, NO en este archivo ni en el código. Los bots los leen
# de event.secrets. Referencia de nombres (sin valores):
#
# WhatsApp (cuenta Twilio de SOM; sender = número de la WABA de EPA Bienestar IA):
#   TWILIO_ACCOUNT_SID
#   TWILIO_AUTH_TOKEN
#   TWILIO_WHATSAPP_FROM      whatsapp:+54... (número de la WABA)
#   RECEPCION_WHATSAPP_TO     número de Recepción (aviso de solicitudes del portal)
#
# MercadoPago (credenciales de la cuenta SOM; tokeniza tarjetas, no guardamos datos):
#   MERCADOPAGO_ACCESS_TOKEN
#   MP_WEBHOOK_URL            (opcional) notification_url del webhook
#
# URLs (opcionales: sin el secret se usa el valor de producción, ver src/config/urls.ts)
# y remitente:
#   PORTAL_BASE_URL           https://app.segundaopinionmedica.org  (portal del paciente)
#   APP_BASE_URL              https://recepcion.segundaopinionmedica.org  (app de recepción)
#   EMAIL_FROM                remitente con marca (identidad SES verificada)
#
# Informe SOM (bot-som-report):
#   ANTHROPIC_API_KEY
# =========================================================================
