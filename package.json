{
  "name": "@som/recepcionistas",
  "version": "0.1.0",
  "private": true,
  "description": "Segunda Opinión Médica (CABA) — Herramienta de Recepción · Bloque 0 (Cimientos). Backend Medplum (FHIR R4).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "app"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/index.ts",
    "diagnostico-acceso": "tsx src/seed/diagnostico-acceso.ts",
    "seed:prueba-recordatorios": "tsx src/seed/prueba-recordatorios.ts",
    "datos-demo": "tsx src/seed/datos-demo.ts",
    "limpiar": "tsx src/seed/limpiar.ts",
    "biomarcadores:convencional": "tsx src/seed/rangos-convencionales.ts",
    "bots:bundle": "tsx src/seed/deploy-bots.ts --dry-run",
    "deploy:bots": "tsx src/seed/deploy-bots.ts",
    "email:test": "tsx src/seed/diagnostico-email.ts",
    "whatsapp:test": "tsx src/seed/diagnostico-whatsapp.ts",
    "whatsapp:plantillas": "tsx src/seed/plantillas-whatsapp.ts",
    "webhooks": "tsx src/seed/webhooks.ts",
    "mercadopago:test": "tsx src/seed/diagnostico-mercadopago.ts",
    "mercadopago:e2e": "tsx src/seed/prueba-mercadopago.ts",
    "mercadopago:ordenes": "tsx src/seed/ordenes-mercadopago.ts",
    "verify": "npm run typecheck && npm run test",
    "dev": "npm run dev --workspace @som/recepcion-app",
    "build:app": "npm run build --workspace @som/recepcion-app",
    "app:typecheck": "npm run typecheck --workspace @som/recepcion-app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@medplum/core": "^5.1.42",
    "@medplum/fhirtypes": "^5.1.42"
  },
  "devDependencies": {
    "@medplum/cli": "^5.1.42",
    "@types/node": "^22.18.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
