# Variables del FRONT de recepción (expuestas al navegador vía envPrefix de Vite).
# ⚠️ Solo valores públicos. NUNCA pongas secretos acá (p. ej. MEDPLUM_CLIENT_SECRET):
# con el prefijo MEDPLUM_ quedarían embebidos en el bundle del cliente.

# URL de la API de Medplum (Cloud Segunda Opinión Médica):
MEDPLUM_BASE_URL=https://api.medplum.com.ar/

# Login con Google / Gmail (opcional): client ID público de Google OAuth.
# Con esto seteado, el login de recepción muestra el botón "Sign in with Google".
# Requisitos (ver app/src/pages/SignInPage.tsx):
#  1. OAuth Client ID (tipo Web) en Google Cloud Console, con el dominio de la app
#     (p. ej. https://recepcion.segundaopinionmedica.org) en "Authorized JavaScript origins".
#  2. El mismo Client ID cargado en el proyecto Medplum (Project Settings → Google Client ID).
#  3. El usuario debe existir en Medplum con ese mismo email (Google autentica, no crea usuarios).
# GOOGLE_CLIENT_ID=

# reCAPTCHA (opcional): site key pública.
# RECAPTCHA_SITE_KEY=
